run = "npm run dev"
hidden = [".config", "package-lock.json", "node_modules", "dist", ".bolt"]
entrypoint = "index.html"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run build && npm run preview"]
deploymentTarget = "cloudflare"

[[ports]]
localPort = 5173
externalPort = 80
